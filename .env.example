MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db-name>
PORT=4000
JWT_SECRET=change-me-to-a-long-random-string
OPENAI_API_KEY=sk-proj-...
# Comma-separated. Localhost and *.vercel.app are auto-allowed.
CORS_ORIGINS=https://hearth-plum.vercel.app

# Card printing. Mail goes out through any SMTP service: set SMTP_URL,
# or SMTP_HOST, SMTP_PORT, SMTP_USER and SMTP_PASS. MAIL_FROM is the
# sender. CARD_PRINT_TO is the print room inbox.
SMTP_URL=
MAIL_FROM=
CARD_PRINT_TO=zwleileen@gmail.com
